e\": \"text\",\n        \"fontSize\": 22,\n        \"fontWeight\": 700,\n        \"color\": \"#2C3E50\",\n        \"dy\": -7\n      },\n      \"encoding\": {\n        \"text\": {\n          \"aggregate\": \"sum\",\n          \"field\": \"Consultas Realizadas\",\n          \"type\": \"quantitative\",\n          \"formatType\": \"pbiFormat\",\n          \"format\": \"#,0\"\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"fontSize\": 10,\n        \"color\": \"#64748B\",\n        \"dy\": 13,\n        \"text\": \"consultas\"\n      }\n    }\n  ]\n}'"
