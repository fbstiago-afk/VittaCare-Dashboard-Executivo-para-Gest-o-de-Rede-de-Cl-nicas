            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"transform\": [\n    {\n      \"filter\": \"isValid(datum[''Nota Média'']) && isValid(datum[''Tempo Espera Médio''])\"\n    },\n    {\n      \"calculate\": \"datum[''Nota Média''] + (((datum.ID_Atendimento * 9301 + 49297) % 233280) / 233280 - 0.5) * 0.6\",\n      \"as\": \"notaJitter\"\n    },\n    {\n      \"calculate\": \"datum[''Tempo Espera Médio''] > 30 ? ''Acima da meta (> 30 min)'' : ''Dentro da meta (≤ 30 min)''\",\n      \"as\": \"faixa\"\n    }\n  ],\n  \"layer\": [\n    {\n      \"data\": {\n        \"values\": [\n          {}\n        ]\n      },\n      \"mark\": {\n        \"type\": \"rect\",\n        \"color\": \"#E8505B\",\n        \"opacity\": 0.05\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 30,\n          \"type\": \"quantitative\"\n        },\n        \"x2\": {\n          \"datum\": 62\n        }\n      }\n    },\n    {\n      \"data\": {\n        \"values\": [\n          {}\n        ]\n      },\n      \"mark\": {\n        \"type\": \"rule\",\n        \"color\": \"#E8505B\",\n        \"strokeDash\": [\n          4,\n          4\n        ],\n        \"strokeWidth\": 1.2,\n        \"opacity\": 0.7\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 30,\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"data\": {\n        \"values\": [\n          {}\n        ]\n      },\n      \"mark\": {\n        \"type\": \"text\",\n        \"color\": \"#E8505B\",\n        \"align\": \"left\",\n        \"baseline\": \"top\",\n        \"dx\": 5,\n        \"y\": 4,\n        \"fontSize\": 10,\n        \"fontWeight\": 600,\n        \"text\": \"Meta 30 min\"\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 30,\n          \"type\": \"quantitative\"\n        }\n      }\n    },\n    {\n      \"params\": [\n        {\n          \"name\": \"legenda\",\n          \"select\": {\n            \"type\": \"point\",\n            \"fields\": [\n              \"faixa\"\n            ]\n          },\n          \"bind\": \"legend\"\n        }\n      ],\n      \"mark\": {\n        \"type\": \"circle\",\n        \"size\": 52,\n        \"stroke\": \"white\",\n        \"strokeWidth\": 0.6,\n        \"cursor\": \"pointer\",\n        \"tooltip\": true\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Tempo Espera Médio\",\n          \"type\": \"quantitative\",\n          \"title\": \"Tempo de espera (min)\",\n          \"scale\": {\n            \"domain\": [\n              0,\n              62\n            ],\n            \"nice\": false\n          },\n          \"axis\": {\n            \"grid\": true,\n            \"gridColor\": \"#EEF2F6\",\n            \"gridDash\": [\n              3,\n              3\n            ],\n            \"values\": [\n              0,\n              10,\n              20,\n              30,\n              40,\n              50,\n              60\n            ]\n          }\n        },\n        \"y\": {\n          \"field\": \"notaJitter\",\n          \"type\": \"quantitative\",\n          \"title\": \"Nota do atendimento\",\n          \"scale\": {\n            \"domain\": [\n              2.5,\n              5.5\n            ],\n            \"nice\": false\n          },\n          \"axis\": {\n            \"values\": [\n              3,\n              4,\n              5\n            ],\n            \"grid\": true,\n            \"gridColor\": \"#EEF2F6\",\n            \"gridDash\": [\n              3,\n              3\n            ],\n            \"format\": \".0f\"\n          }\n        },\n        \"color\": {\n          \"field\": \"faixa\",\n          \"type\": \"nominal\",\n          \"scale\": {\n            \"domain\": [\n              \"Dentro da meta (≤ 30 min)\",\n              \"Acima da meta (> 30 min)\"\n            ],\n            \"range\": [\n              \"#00CBA9\",\n              \"#2C3E50\"\n            ]\n          },\n          \"legend\": {\n            \"orient\": \"top\",\n            \"title\": null,\n            \"direction\": \"horizontal\"\n          }\n        },\n        \"opacity\": {\n          \"condition\": {\n            \"param\": \"legenda\",\n            \"value\": 0.6\n          },\n          \"value\": 0.08\n        }\n      }\n    },\n    {\n      \"transform\": [\n        {\n          \"regression\": \"Nota Média\",\n          \"on\": \"Tempo Espera Médio\",\n          \"extent\": [\n            0,\n            62\n          ]\n        }\n      ],\n      \"mark\": {\n        \"type\": \"line\",\n        \"color\": \"#2C3E50\",\n        \"strokeWidth\": 2.2,\n        \"strokeDash\": [\n          7,\n          5\n        ]\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Tempo Espera Médio\",\n          \"type\": \"quantitative\"\n        },\n        \"y\": {\n          \"field\": \"Nota Média\",\n          \"type\": \"quantitative\"\n        }\n      }\n    }\n  ]\n}'"
