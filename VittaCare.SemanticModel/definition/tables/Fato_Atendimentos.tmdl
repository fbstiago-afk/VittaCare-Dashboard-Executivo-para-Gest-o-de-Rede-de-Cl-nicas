table Fato_Atendimentos
	lineageTag: 40fb764b-69cb-4014-b427-24fc2a8d5d1a

	column ID_Atendimento
		dataType: int64
		formatString: 0
		lineageTag: 8708bf9a-72c8-47be-8118-1cf4f0fba5eb
		summarizeBy: none
		sourceColumn: ID_Atendimento

		annotation SummarizationSetBy = User

	column 'Data Consulta'
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: d99adbfe-62aa-4390-8b1e-cfa93d3d0e55
		summarizeBy: none
		sourceColumn: Data Consulta

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column ID_Clinica
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 566bf1cd-2a0a-465c-86e8-4efc67c6c136
		summarizeBy: none
		sourceColumn: ID_Clinica

		annotation SummarizationSetBy = User

	column ID_Medico
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ae65220d-71c8-403f-9067-4342e08b78fa
		summarizeBy: none
		sourceColumn: ID_Medico

		annotation SummarizationSetBy = User

	column ID_Paciente
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 47152c89-1c29-459e-aa3d-5f388820a149
		summarizeBy: none
		sourceColumn: ID_Paciente

		annotation SummarizationSetBy = User

	column 'Status Consulta'
		dataType: string
		lineageTag: 6da5c39e-01c4-41f1-8cc8-010500d954fa
		summarizeBy: none
		sourceColumn: Status Consulta

		annotation SummarizationSetBy = User

	column 'Valor Cobrado'
		dataType: double
		formatString: R$ #,0.00
		lineageTag: 6b396064-1f7f-4490-aa5b-583d0a5960d4
		summarizeBy: none
		sourceColumn: Valor Cobrado

		annotation SummarizationSetBy = User

	column 'Tempo Espera (min)'
		dataType: int64
		formatString: 0
		lineageTag: 2e75375e-008a-4398-b5fd-df4502dadef2
		summarizeBy: none
		sourceColumn: Tempo Espera (min)

		annotation SummarizationSetBy = User

	column 'Nota Atendimento'
		dataType: int64
		formatString: 0
		lineageTag: 04e13ee4-b384-45fb-9efb-7ff6d7abb724
		summarizeBy: none
		sourceColumn: Nota Atendimento

		annotation SummarizationSetBy = User

	column ID_Especialidade
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7eb55c2c-ceff-4e95-aa26-737b1e632a7d
		summarizeBy: none
		sourceColumn: ID_Especialidade

		annotation SummarizationSetBy = User

	partition Fato_Atendimentos = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "VittaCare_Database.xlsx"), null, true),
				    Aba = Fonte{[Item="Fato_Atendimentos",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"ID_Atendimento", Int64.Type}, {"ID_Clinica", Int64.Type}, {"ID_Medico", Int64.Type}, {"ID_Paciente", Int64.Type}, {"Status_Consulta", type text}, {"Valor_Cobrado", type number}, {"Tempo_Espera_Min", Int64.Type}, {"Nota_Atendimento", Int64.Type}}),
				    DataConsulta = Table.TransformColumns(Tipos, {{"Data_Consulta", each Date.FromText(Text.From(_), [Format="dd/MM/yyyy", Culture="pt-BR"]), type date}}),
				    // Star Schema: traz o ID_Especialidade para a fato (evita snowflake Médico -> Especialidade)
				    Medicos = Table.TransformColumnTypes(Table.PromoteHeaders(Fonte{[Item="Dim_Medicos",Kind="Sheet"]}[Data], [PromoteAllScalars=true]), {{"ID_Medico", Int64.Type}, {"ID_Especialidade", Int64.Type}}),
				    Mesclar = Table.NestedJoin(DataConsulta, {"ID_Medico"}, Medicos, {"ID_Medico"}, "Med", JoinKind.LeftOuter),
				    Expandir = Table.ExpandTableColumn(Mesclar, "Med", {"ID_Especialidade"}),
				    TipoEsp = Table.TransformColumnTypes(Expandir, {{"ID_Especialidade", Int64.Type}}),
				    Renomear = Table.RenameColumns(TipoEsp, {{"Data_Consulta", "Data Consulta"}, {"Status_Consulta", "Status Consulta"}, {"Valor_Cobrado", "Valor Cobrado"}, {"Tempo_Espera_Min", "Tempo Espera (min)"}, {"Nota_Atendimento", "Nota Atendimento"}})
				in
				    Renomear

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

