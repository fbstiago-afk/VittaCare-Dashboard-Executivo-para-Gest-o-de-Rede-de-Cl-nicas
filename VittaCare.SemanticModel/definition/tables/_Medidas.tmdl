	/// Cartão HTML animado: Receita Convênios. Use no visual HTML Content.
	measure 'HTML Card Convenios' =
			VAR _p = [% Receita Convênios]
			VAR _acc = "#00CBA9"
			VAR _rgb = "0,203,169"
