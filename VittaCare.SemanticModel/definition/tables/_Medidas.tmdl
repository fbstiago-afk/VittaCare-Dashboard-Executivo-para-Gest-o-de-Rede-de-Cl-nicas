			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Taxa de No-Show</span>"
			        & "<div class='ico pulse'><svg viewBox='0 0 24 24'><path d='M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='8.5' cy='7' r='4'/><line x1='18' y1='8' x2='23' y2='13'/><line x1='23' y1='8' x2='18' y2='13'/></svg></div></div>"
			        & "<div class='val' style='color:" & IF ( _acima, "#D64550", "#00A88C" ) & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & "<div class='bar'><i style='width:" & FORMAT ( MIN ( DIVIDE ( _taxa, _escala ), 1 ) * 100, "0.0", "en-US" ) & "%;background:" & _acc & "'></i>"
			            & "<b style='left:" & FORMAT ( DIVIDE ( _meta, _escala ) * 100, "0.0", "en-US" ) & "%'></b></div>"
			            & "<span>meta &lt; " & FORMAT ( _meta, "0%", "pt-BR" ) & "</span>" & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Faltas sem aviso</div><div class='mg'>" & "<div><span>No-show</span><b>" & ( IF ( ISBLANK ( [Consultas No-Show] ), "—", FORMAT ( [Consultas No-Show], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Receita perdida</span><b>" & ( IF ( ISBLANK ( [Consultas No-Show] * [Ticket Médio] ), "—", "R$ " & IF ( [Consultas No-Show] * [Ticket Médio] >= 1000000, FORMAT ( [Consultas No-Show] * [Ticket Médio] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Consultas No-Show] * [Ticket Médio] >= 1000, FORMAT ( [Consultas No-Show] * [Ticket Médio] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Consultas No-Show] * [Ticket Médio], "#,0", "pt-BR" ) ) ) ) ) & "</b></div>" & "<div><span>Gap p/ meta</span><b>" & ( FORMAT ( ( [% No-Show] - [Meta No-Show] ) * 100, "+0.0;-0.0", "pt-BR" ) & " pp" ) & "</b></div>" & "<div><span>Pior unidade</span><b>" & ( [Top Unidade No-Show] ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Plano com mais faltas: <b>" & [Top Plano No-Show] & " (" & FORMAT ( CALCULATE ( [% No-Show], TREATAS ( { [Top Plano No-Show] }, Dim_Pacientes[Plano de Saúde] ) ), "0.0%", "pt-BR" ) & ")" & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: 49ba0b26-30dd-4a3d-bd76-723d619dc706

	measure 'Faturamento Média Mensal' =
			AVERAGEX (
			    FILTER ( VALUES ( Dim_Calendario[AnoMes] ), NOT ISBLANK ( [Faturamento Total] ) ),
			    [Faturamento Total]
			)
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 07 Apoio Tooltips
		lineageTag: 0dd270ab-b286-47f0-8af7-a20470ec13d9

	measure 'Consultas Média Mensal' =
			AVERAGEX (
			    FILTER ( VALUES ( Dim_Calendario[AnoMes] ), NOT ISBLANK ( [Agendamentos] ) ),
			    [Consultas Realizadas]
			)
		formatString: #,0.0
		displayFolder: 07 Apoio Tooltips
		lineageTag: 6098a60a-6cd7-4c45-82b4-f06e768846e1

	/// Estimativa de receita não realizada: (canceladas + no-show) × ticket médio.
	measure 'Receita Perdida Estimada' = ( [Consultas Canceladas] + [Consultas No-Show] ) * [Ticket Médio]
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 07 Apoio Tooltips
		lineageTag: dbe01c21-54b3-477a-9d7c-a3e5fe3d32fa

	measure 'Ticket Médio Convênio' =
			DIVIDE (
			    [Receita Convênios],
			    CALCULATE ( [Consultas Realizadas], KEEPFILTERS ( Dim_Pacientes[Tipo de Cobertura] = "Convênio" ) )
			)
		formatString: R$ #,0.00;-R$ #,0.00;R$ #,0.00
		displayFolder: 07 Apoio Tooltips
		lineageTag: c9bc957d-ffc1-4b2a-ae96-4fe0d8d65a99

	/// Preço de tabela médio das consultas realizadas.
	measure 'Valor Tabela Médio' =
			CALCULATE (
			    AVERAGEX ( Fato_Atendimentos, RELATED ( Dim_Especialidades[Valor Base Consulta] ) ),
			    KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "Realizada" )
			)
		formatString: R$ #,0.00;-R$ #,0.00;R$ #,0.00
		displayFolder: 07 Apoio Tooltips
		lineageTag: 1f33cfeb-233c-4abd-be44-03fb6cfa8881

	measure '% Realização de Preço' = DIVIDE ( [Ticket Médio], [Valor Tabela Médio] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Apoio Tooltips
		lineageTag: b44ea43f-b837-4231-89f8-80c4cb34c521

	measure 'Nota Espera Dentro SLA' = CALCULATE ( [Nota Média], KEEPFILTERS ( Fato_Atendimentos[Tempo Espera (min)] <= 30 ) )
