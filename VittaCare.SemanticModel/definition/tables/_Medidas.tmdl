		lineageTag: d881edcb-aad6-42d4-a6a5-8011cbc41bd5

	measure 'Nota Espera Fora SLA' = CALCULATE ( [Nota Média], KEEPFILTERS ( Fato_Atendimentos[Tempo Espera (min)] > 30 ) )
