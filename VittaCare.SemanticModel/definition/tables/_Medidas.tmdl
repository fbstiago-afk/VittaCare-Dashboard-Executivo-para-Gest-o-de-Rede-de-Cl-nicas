			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:28px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Receita Convênios</span>"
			        & "<div class='ico pulse'><svg viewBox='0 0 24 24'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/><path d='M9 12l2 2 4-4'/></svg></div></div>"
			        & "<div class='val' style='color:" & "#00A88C" & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & "<span class='pill' style='background:rgba(0,203,169,0.14);color:#00A88C'>" & FORMAT ( _p, "0.0%", "pt-BR" ) & "</span><span>do faturamento</span>" & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Receita de convênios</div><div class='mg'>" & "<div><span>Consultas</span><b>" & ( IF ( ISBLANK ( [Consultas Convênio] ), "—", FORMAT ( [Consultas Convênio], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Ticket</span><b>" & ( "R$ " & IF ( ISBLANK ( [Ticket Médio Convênio] ), "—", FORMAT ( [Ticket Médio Convênio], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Pacientes</span><b>" & ( IF ( ISBLANK ( [Pacientes Convênio] ), "—", FORMAT ( [Pacientes Convênio], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>% do total</span><b>" & ( IF ( ISBLANK ( [% Receita Convênios] ), "—", FORMAT ( [% Receita Convênios], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Maior convênio: <b>" & [Top Convênio Receita] & " (" & "R$ " & FORMAT ( CALCULATE ( [Receita Convênios], TREATAS ( { [Top Convênio Receita] }, Dim_Pacientes[Plano de Saúde] ) ), "#,0", "pt-BR" ) & ")" & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: 649df7e3-bedb-4f4f-ab6f-194a87c99604

