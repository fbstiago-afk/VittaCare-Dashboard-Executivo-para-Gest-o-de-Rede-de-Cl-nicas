table _Medidas
	lineageTag: e4d091b0-7d65-4a3f-acc6-971b2ef69d14

	/// Soma do valor cobrado nas consultas.
	measure 'Faturamento Total' = SUM ( Fato_Atendimentos[Valor Cobrado] )
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 01 Faturamento
		lineageTag: f2184778-a827-4174-b992-d7c86e5275b4

	/// Faturamento do último ano no contexto (respeita filtro de mês/unidade).
	measure 'Faturamento Ano Atual' =
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			RETURN
			    CALCULATE ( [Faturamento Total], Dim_Calendario[Ano] = _ano )
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 01 Faturamento
		lineageTag: eaf846b4-1e5b-41d6-9943-2fca9ab781cf

	/// Faturamento do ano anterior ao último ano no contexto.
	measure 'Faturamento Ano Anterior' =
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			RETURN
			    CALCULATE ( [Faturamento Total], Dim_Calendario[Ano] = _ano - 1 )
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 01 Faturamento
		lineageTag: be275cb7-7b44-489e-ae8a-0eac71675807

	/// Variação % do faturamento vs. ano anterior.
	measure 'Faturamento Var % AA' =
			VAR _atual = [Faturamento Ano Atual]
			VAR _anterior = [Faturamento Ano Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Faturamento
		lineageTag: 5244eaca-4ae1-4750-852e-a283ba6b456b

	/// Faturamento médio por consulta realizada.
	measure 'Ticket Médio' = DIVIDE ( [Faturamento Total], [Consultas Realizadas] )
		formatString: R$ #,0.00;-R$ #,0.00;R$ #,0.00
		displayFolder: 01 Faturamento
		lineageTag: 537e1606-99b5-4cd2-a3e7-86b42da89a75

	measure 'Ticket Médio Var % AA' =
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			VAR _atual = CALCULATE ( [Ticket Médio], Dim_Calendario[Ano] = _ano )
			VAR _anterior = CALCULATE ( [Ticket Médio], Dim_Calendario[Ano] = _ano - 1 )
			RETURN
			    IF ( NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Faturamento
		lineageTag: 17b1810e-58d6-425d-8a40-b4e8cc754ad2

	measure 'Receita Convênios' = CALCULATE ( [Faturamento Total], KEEPFILTERS ( Dim_Pacientes[Tipo de Cobertura] = "Convênio" ) )
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 01 Faturamento
		lineageTag: c7c63969-5903-44d2-9b3e-f7dd49044491

	measure 'Receita Particular' = CALCULATE ( [Faturamento Total], KEEPFILTERS ( Dim_Pacientes[Tipo de Cobertura] = "Particular" ) )
		formatString: R$ #,0;-R$ #,0;R$ #,0
		displayFolder: 01 Faturamento
		lineageTag: 7f18036d-f0a3-4a13-bb45-768410c9990d

	measure '% Receita Convênios' = DIVIDE ( [Receita Convênios], [Faturamento Total] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Faturamento
		lineageTag: 840c89dd-1975-433f-9c43-d4857c2b50cc

	measure 'Ticket Médio Particular' =
			DIVIDE (
			    [Receita Particular],
			    CALCULATE ( [Consultas Realizadas], KEEPFILTERS ( Dim_Pacientes[Tipo de Cobertura] = "Particular" ) )
			)
		formatString: R$ #,0.00;-R$ #,0.00;R$ #,0.00
		displayFolder: 01 Faturamento
		lineageTag: e4ef2c26-faf6-4980-afff-8f80a27beb5a

	/// Total de consultas agendadas (todas as situações).
	measure Agendamentos = COUNTROWS ( Fato_Atendimentos )
		formatString: #,0
		displayFolder: 02 Volume
		lineageTag: b0734daf-24ac-4236-bdb8-e7aee480cdd5

	measure 'Consultas Realizadas' = CALCULATE ( COUNTROWS ( Fato_Atendimentos ), KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "Realizada" ) )
		formatString: #,0
		displayFolder: 02 Volume
		lineageTag: 91716fae-a7f3-47e2-893c-af07afd0d0b3

	measure 'Consultas Canceladas' = CALCULATE ( COUNTROWS ( Fato_Atendimentos ), KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "Cancelada" ) )
		formatString: #,0
		displayFolder: 02 Volume
		lineageTag: 738ca035-2cea-443c-a284-fc7c9c4b0b89

	measure 'Consultas No-Show' = CALCULATE ( COUNTROWS ( Fato_Atendimentos ), KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "No-Show" ) )
		formatString: #,0
		displayFolder: 02 Volume
		lineageTag: 141127f9-0cce-4893-8813-b1f28c179c61

	measure 'Consultas Realizadas Var % AA' =
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			VAR _atual = CALCULATE ( [Consultas Realizadas], Dim_Calendario[Ano] = _ano )
			VAR _anterior = CALCULATE ( [Consultas Realizadas], Dim_Calendario[Ano] = _ano - 1 )
			RETURN
			    IF ( NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Volume
		lineageTag: cf6d6427-3ce5-4e6e-b3b0-be0f890d3d2d

	measure '% Realização' = DIVIDE ( [Consultas Realizadas], [Agendamentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Volume
		lineageTag: d6d4ceee-268f-4baa-b459-43ce6c90689f

	measure 'Pacientes Únicos' = DISTINCTCOUNT ( Fato_Atendimentos[ID_Paciente] )
		formatString: #,0
		displayFolder: 02 Volume
		lineageTag: 84638480-1ed7-48aa-a858-7b964408d599

	measure 'Consultas por Paciente' = DIVIDE ( [Consultas Realizadas], [Pacientes Únicos] )
		formatString: 0.0
		displayFolder: 02 Volume
		lineageTag: 6ad2a1ca-be93-4a12-ab9b-7f59862f733b

	measure '% Cancelamento' = DIVIDE ( [Consultas Canceladas], [Agendamentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Cancelamento & No-Show
		lineageTag: efeec969-5782-47d6-95ba-8969d9cc0d59

	measure '% No-Show' = DIVIDE ( [Consultas No-Show], [Agendamentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Cancelamento & No-Show
		lineageTag: 9b41b1fa-d363-4e6c-9f22-1135c51e9b8c

	measure '% Perda Total' = DIVIDE ( [Consultas Canceladas] + [Consultas No-Show], [Agendamentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Cancelamento & No-Show
		lineageTag: d5c6196f-2d6f-4928-9975-dfe035bb0fa5

	/// Meta corporativa: cancelamento abaixo de 10%.
	measure 'Meta Cancelamento' = 0.10
		formatString: 0%
		displayFolder: 03 Cancelamento & No-Show
		lineageTag: 32aed856-8cbd-4935-845e-0ab8509fb493

	/// Meta corporativa: no-show abaixo de 5%.
	measure 'Meta No-Show' = 0.05
		formatString: 0%
		displayFolder: 03 Cancelamento & No-Show
		lineageTag: 52892454-cec8-42cf-9010-2f6f931af5e6

	/// Média das avaliações (1 a 5) das consultas realizadas.
	measure 'Nota Média' = AVERAGE ( Fato_Atendimentos[Nota Atendimento] )
		formatString: 0.00
		displayFolder: 04 Qualidade Clínica
		lineageTag: 7a18581c-982d-441b-93fb-c7c1a71c9ca9

	measure 'Qtd Avaliações' = COUNT ( Fato_Atendimentos[Nota Atendimento] )
		formatString: #,0
		displayFolder: 04 Qualidade Clínica
		lineageTag: 5825ac65-19cd-4cfa-83d5-689e91a22f25

	/// Tempo médio de espera (min) apenas das consultas realizadas.
	measure 'Tempo Espera Médio' = CALCULATE ( AVERAGE ( Fato_Atendimentos[Tempo Espera (min)] ), KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "Realizada" ) )
		formatString: 0.0
		displayFolder: 04 Qualidade Clínica
		lineageTag: b2397ef2-52d9-4d85-ad27-b21f62b22a8f

	measure 'Meta Tempo Espera' = 30
		formatString: 0
		displayFolder: 04 Qualidade Clínica
		lineageTag: 9ec02825-208b-4521-b484-e6d1e6801902

	measure '% Dentro SLA Espera' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( Fato_Atendimentos ),
			        KEEPFILTERS ( Fato_Atendimentos[Status Consulta] = "Realizada" ),
			        KEEPFILTERS ( Fato_Atendimentos[Tempo Espera (min)] <= 30 )
			    ),
			    [Consultas Realizadas]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Qualidade Clínica
		lineageTag: e006201b-3cda-4c4f-8611-02847f980c32

	measure 'Cor Status' =
			SWITCH (
			    SELECTEDVALUE ( Fato_Atendimentos[Status Consulta] ),
			    "Realizada", "#00A88C",
			    "Cancelada", "#E8505B",
			    "No-Show", "#E59A1F",
			    "#64748B"
			)
		displayFolder: 05 Formatação Condicional
		lineageTag: eb102f7b-a1ef-4086-b39a-8c90dae9f753

	measure 'Cor Fundo Cancelamento' = IF ( [% Cancelamento] > [Meta Cancelamento], "#FDECEE", "#E6FAF6" )
		displayFolder: 05 Formatação Condicional
		lineageTag: affe60e0-7ee1-411e-853c-b2b764f2360d

	measure 'Cor Fonte Cancelamento' = IF ( [% Cancelamento] > [Meta Cancelamento], "#C0392B", "#00866F" )
		displayFolder: 05 Formatação Condicional
		lineageTag: 3ea8ab1b-7e00-4ddf-a4f5-5c2328802119

	measure 'Cor Espera' = IF ( SUM ( Fato_Atendimentos[Tempo Espera (min)] ) > [Meta Tempo Espera], "#E8505B", "#64748B" )
		displayFolder: 05 Formatação Condicional
		lineageTag: d9190466-826c-48c7-8e12-c451cffaf142

	measure 'Cor Nota' = SWITCH ( TRUE (), ISBLANK ( [Nota Média] ), "#CBD5E1", [Nota Média] >= 4.5, "#00A88C", [Nota Média] < 3.5, "#E8505B", "#2C3E50" )
		displayFolder: 05 Formatação Condicional
		lineageTag: 6db6a2af-b9a2-47a9-bfd7-5cdd5c7a8075

	/// Cartão HTML animado: Faturamento Total. Use no visual HTML Content.
	measure 'HTML Card Faturamento' =
			VAR _v = [Faturamento Var % AA]
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			VAR _pill =
			    IF (
			        ISBLANK ( _v ),
			        "<span class='pill' style='background:#F1F5F9;color:#64748B'>sem base</span><span>ano anterior</span>",
			        "<span class='pill' style='background:" & IF ( _v >= 0, "rgba(0,203,169,0.14);color:#00A88C'>▲ +", "rgba(232,80,91,0.12);color:#D64550'>▼ -" )
			            & FORMAT ( ABS ( _v ), "0.0%", "pt-BR" ) & "</span><span>" & _ano & " vs. " & ( _ano - 1 ) & "</span>"
			    )
			VAR _acc = "#00CBA9"
			VAR _rgb = "0,203,169"
			VAR _valor = IF ( ISBLANK ( [Faturamento Total] ), "—", "R$ " & IF ( [Faturamento Total] >= 1000000, FORMAT ( [Faturamento Total] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Faturamento Total] >= 1000, FORMAT ( [Faturamento Total] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Faturamento Total], "#,0", "pt-BR" ) ) ) )
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Faturamento Total</span>"
			        & "<div class='ico pulse'><svg viewBox='0 0 24 24'><line x1='12' y1='2' x2='12' y2='22'/><path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg></div></div>"
			        & "<div class='val' style='color:" & "#00A88C" & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & _pill & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Detalhe do faturamento</div><div class='mg'>" & "<div><span>Ano atual</span><b>" & ( IF ( ISBLANK ( [Faturamento Ano Atual] ), "—", "R$ " & IF ( [Faturamento Ano Atual] >= 1000000, FORMAT ( [Faturamento Ano Atual] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Faturamento Ano Atual] >= 1000, FORMAT ( [Faturamento Ano Atual] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Faturamento Ano Atual], "#,0", "pt-BR" ) ) ) ) ) & "</b></div>" & "<div><span>Ano anterior</span><b>" & ( IF ( ISBLANK ( [Faturamento Ano Anterior] ), "—", "R$ " & IF ( [Faturamento Ano Anterior] >= 1000000, FORMAT ( [Faturamento Ano Anterior] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Faturamento Ano Anterior] >= 1000, FORMAT ( [Faturamento Ano Anterior] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Faturamento Ano Anterior], "#,0", "pt-BR" ) ) ) ) ) & "</b></div>" & "<div><span>Média/mês</span><b>" & ( IF ( ISBLANK ( [Faturamento Média Mensal] ), "—", "R$ " & IF ( [Faturamento Média Mensal] >= 1000000, FORMAT ( [Faturamento Média Mensal] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Faturamento Média Mensal] >= 1000, FORMAT ( [Faturamento Média Mensal] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Faturamento Média Mensal], "#,0", "pt-BR" ) ) ) ) ) & "</b></div>" & "<div><span>Convênios</span><b>" & ( IF ( ISBLANK ( [% Receita Convênios] ), "—", FORMAT ( [% Receita Convênios], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Unidade líder: <b>" & [Top Unidade Faturamento] & "</b>" & " · melhor mês <b>" & [Melhor Mês Faturamento] & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: 438bed6c-3aad-4cc5-969e-21f3ae44b506

	/// Cartão HTML animado: Total de Consultas. Use no visual HTML Content.
	measure 'HTML Card Consultas' =
			VAR _v = [Consultas Realizadas Var % AA]
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			VAR _pill =
			    IF (
			        ISBLANK ( _v ),
			        "<span class='pill' style='background:#F1F5F9;color:#64748B'>sem base</span><span>ano anterior</span>",
			        "<span class='pill' style='background:" & IF ( _v >= 0, "rgba(0,203,169,0.14);color:#00A88C'>▲ +", "rgba(232,80,91,0.12);color:#D64550'>▼ -" )
			            & FORMAT ( ABS ( _v ), "0.0%", "pt-BR" ) & "</span><span>" & _ano & " vs. " & ( _ano - 1 ) & "</span>"
			    )
			VAR _ag = [Agendamentos]
			VAR _acc = "#2C3E50"
			VAR _rgb = "44,62,80"
			VAR _valor = IF ( ISBLANK ( [Consultas Realizadas] ), "—", FORMAT ( [Consultas Realizadas], "#,0", "pt-BR" ) ) & "<small>de " & FORMAT ( _ag, "#,0", "pt-BR" ) & " agend.</small>"
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Total de Consultas</span>"
			        & "<div class='ico beat'><svg viewBox='0 0 24 24'><polyline points='22 12 18 12 15 21 9 3 6 12 2 12'/></svg></div></div>"
			        & "<div class='val' style='color:" & "#2C3E50" & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & _pill & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Volume de atendimentos</div><div class='mg'>" & "<div><span>Realização</span><b>" & ( IF ( ISBLANK ( [% Realização] ), "—", FORMAT ( [% Realização], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Média/mês</span><b>" & ( IF ( ISBLANK ( [Consultas Média Mensal] ), "—", FORMAT ( [Consultas Média Mensal], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Canceladas</span><b>" & ( IF ( ISBLANK ( [Consultas Canceladas] ), "—", FORMAT ( [Consultas Canceladas], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>No-show</span><b>" & ( IF ( ISBLANK ( [Consultas No-Show] ), "—", FORMAT ( [Consultas No-Show], "#,0", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Mais procurada: <b>" & [Top Especialidade Consultas] & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: e868cf5b-5cc8-4c58-a309-718de2c1f743

	/// Cartão HTML animado: Taxa de Cancelamento. Use no visual HTML Content.
	measure 'HTML Card Cancelamento' =
			VAR _taxa = [% Cancelamento]
			VAR _meta = [Meta Cancelamento]
			VAR _ns = [% No-Show]
			VAR _acima = _taxa > _meta
			VAR _escala = 0.40
			VAR _acc = IF ( _acima, "#E8505B", "#00CBA9" )
			VAR _rgb = IF ( _acima, "232,80,91", "0,203,169" )
			VAR _valor = IF ( ISBLANK ( _taxa ), "—", FORMAT ( _taxa, "0.0%", "pt-BR" ) ) & "<small>+ " & FORMAT ( _ns, "0.0%", "pt-BR" ) & " no-show</small>"
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Taxa de Cancelamento</span>"
			        & "<div class='ico pulse'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><path d='M15 9l-6 6M9 9l6 6'/></svg></div></div>"
			        & "<div class='val' style='color:" & IF ( _acima, "#D64550", "#00A88C" ) & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & "<div class='bar'><i style='width:" & FORMAT ( MIN ( DIVIDE ( _taxa, _escala ), 1 ) * 100, "0.0", "en-US" ) & "%;background:" & _acc & "'></i>"
			            & "<b style='left:" & FORMAT ( DIVIDE ( _meta, _escala ) * 100, "0.0", "en-US" ) & "%'></b></div>"
			            & "<span>meta &lt; " & FORMAT ( _meta, "0%", "pt-BR" ) & "</span>" & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Impacto das perdas</div><div class='mg'>" & "<div><span>Canceladas</span><b>" & ( IF ( ISBLANK ( [Consultas Canceladas] ), "—", FORMAT ( [Consultas Canceladas], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>No-show</span><b>" & ( IF ( ISBLANK ( [Consultas No-Show] ), "—", FORMAT ( [Consultas No-Show], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Perda total</span><b>" & ( IF ( ISBLANK ( [% Perda Total] ), "—", FORMAT ( [% Perda Total], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Receita perdida</span><b>" & ( IF ( ISBLANK ( [Receita Perdida Estimada] ), "—", "R$ " & IF ( [Receita Perdida Estimada] >= 1000000, FORMAT ( [Receita Perdida Estimada] / 1000000, "#,0.0", "pt-BR" ) & " mi", IF ( [Receita Perdida Estimada] >= 1000, FORMAT ( [Receita Perdida Estimada] / 1000, "#,0.0", "pt-BR" ) & " mil", FORMAT ( [Receita Perdida Estimada], "#,0", "pt-BR" ) ) ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Maior cancelamento: <b>" & [Top Unidade Cancelamento] & " (" & FORMAT ( CALCULATE ( [% Cancelamento], TREATAS ( { [Top Unidade Cancelamento] }, Dim_Clinicas[Unidade] ) ), "0.0%", "pt-BR" ) & ")" & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: 08692fa8-e9bd-4dd0-be95-d1f49d5c449e

	/// Cartão HTML animado: Ticket Médio. Use no visual HTML Content.
	measure 'HTML Card Ticket' =
			VAR _v = [Ticket Médio Var % AA]
			VAR _ano = MAX ( Dim_Calendario[Ano] )
			VAR _pill =
			    IF (
			        ISBLANK ( _v ),
			        "<span class='pill' style='background:#F1F5F9;color:#64748B'>sem base</span><span>ano anterior</span>",
			        "<span class='pill' style='background:" & IF ( _v >= 0, "rgba(0,203,169,0.14);color:#00A88C'>▲ +", "rgba(232,80,91,0.12);color:#D64550'>▼ -" )
			            & FORMAT ( ABS ( _v ), "0.0%", "pt-BR" ) & "</span><span>" & _ano & " vs. " & ( _ano - 1 ) & "</span>"
			    )
			VAR _acc = "#2C3E50"
			VAR _rgb = "44,62,80"
			VAR _valor = "R$ " & IF ( ISBLANK ( [Ticket Médio] ), "—", FORMAT ( [Ticket Médio], "#,0.00", "pt-BR" ) )
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:30px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Ticket Médio</span>"
			        & "<div class='ico spin'><svg viewBox='0 0 24 24'><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'/><line x1='7' y1='7' x2='7.01' y2='7'/></svg></div></div>"
			        & "<div class='val' style='color:" & "#2C3E50" & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & _pill & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Composição do ticket</div><div class='mg'>" & "<div><span>Particular</span><b>" & ( "R$ " & IF ( ISBLANK ( [Ticket Médio Particular] ), "—", FORMAT ( [Ticket Médio Particular], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Convênio</span><b>" & ( "R$ " & IF ( ISBLANK ( [Ticket Médio Convênio] ), "—", FORMAT ( [Ticket Médio Convênio], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Preço tabela</span><b>" & ( "R$ " & IF ( ISBLANK ( [Valor Tabela Médio] ), "—", FORMAT ( [Valor Tabela Médio], "#,0", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Realização</span><b>" & ( IF ( ISBLANK ( [% Realização de Preço] ), "—", FORMAT ( [% Realização de Preço], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Maior ticket: <b>" & [Top Especialidade Ticket] & " (" & "R$ " & FORMAT ( CALCULATE ( [Ticket Médio], TREATAS ( { [Top Especialidade Ticket] }, Dim_Especialidades[Especialidade] ) ), "#,0", "pt-BR" ) & ")" & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: 43a98008-1e0c-4634-b4e6-c56fc96e31f0

	/// Banner de boas-vindas (hero) da Visão Executiva.
	measure 'HTML Hero Executivo' =
			VAR _ini = MIN ( Dim_Calendario[Data] )
			VAR _fim = MAX ( Dim_Calendario[Data] )
			VAR _periodo = FORMAT ( _ini, "mmm/yy", "pt-BR" ) & " – " & FORMAT ( _fim, "mmm/yy", "pt-BR" )
			VAR _unid = COUNTROWS ( VALUES ( Dim_Clinicas[Unidade] ) )
			VAR _hora = HOUR ( UTCNOW () - 3 / 24 )  -- horário de Brasília
			VAR _saud = IF ( _hora < 12, "Bom dia", IF ( _hora < 18, "Boa tarde", "Boa noite" ) )
			RETURN
			    "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}"
			        & ".hero{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 16px);margin:6px 8px 10px 8px;border-radius:18px;padding:0 28px;"
			        & "background:linear-gradient(120deg,#2C3E50 0%,#22313F 55%,#1B4A4A 100%);color:#fff;display:flex;justify-content:space-between;align-items:center;"
			        & "position:relative;overflow:hidden;box-shadow:0 10px 26px rgba(44,62,80,0.18);transition:box-shadow .4s ease}"
			        & ".hero:hover{box-shadow:0 16px 34px rgba(44,62,80,0.26)}"
			        & ".hero:before{content:'';position:absolute;top:0;left:-40%;width:35%;height:100%;background:linear-gradient(100deg,rgba(255,255,255,0) 0%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0) 100%);animation:shine 6s ease-in-out infinite}"
			        & ".hero:after{content:'';position:absolute;right:220px;top:-60px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(0,203,169,0.28),rgba(0,203,169,0) 70%);animation:float 7s ease-in-out infinite}"
			        & "@keyframes shine{0%{left:-40%}60%,100%{left:120%}}"
			        & "@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(18px)}}"
			        & "@keyframes blink{0%,100%{box-shadow:0 0 0 0 rgba(46,213,115,0.6)}50%{box-shadow:0 0 0 6px rgba(46,213,115,0)}}"
			        & "@keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}"
			        & ".t{font-size:24px;font-weight:700;letter-spacing:-.4px;animation:up .8s ease both}.t span{color:#00CBA9}"
			        & ".s{font-size:12.5px;color:#CBD5E1;margin-top:6px;font-weight:400;animation:up .8s .15s ease both}.s b{color:#fff;font-weight:600}"
			        & ".st{position:relative;z-index:1;background:rgba(255,255,255,0.08);border:1px solid rgba(0,203,169,0.35);border-radius:10px;padding:8px 16px;backdrop-filter:blur(6px)}"
			        & ".sl{font-size:10px;color:#00CBA9;font-weight:700;letter-spacing:.8px;text-transform:uppercase}"
			        & ".sv{font-size:13px;font-weight:500;margin-top:3px;display:flex;align-items:center;gap:8px}"
			        & ".dot{width:9px;height:9px;border-radius:50%;background:#2ED573;animation:blink 1.8s infinite}</style>"
			        & "<div class='hero'><div style='position:relative;z-index:1'>"
			        & "<div class='t'>" & _saud & ". Portal Executivo <span>VittaCare</span></div>"
			        & "<div class='s'>Faturamento, volume de atendimentos e cancelamentos · <b>" & _periodo & "</b> · <b>" & _unid & "</b> unidade(s)</div></div>"
			        & "<div class='st'><div class='sl'>Status do Sistema</div><div class='sv'><i class='dot'></i>Dados atualizados</div></div></div>"
		displayFolder: 06 HTML Cards
		lineageTag: 0c2e672b-9622-4446-8c55-dd808feb2457

	/// Cartão HTML animado: Nota Média de Atendimento. Use no visual HTML Content.
	measure 'HTML Card Nota' =
			VAR _n = [Nota Média]
			VAR _q = [Qtd Avaliações]
			VAR _acc = "#00CBA9"
			VAR _rgb = "0,203,169"
			VAR _valor = IF ( ISBLANK ( _n ), "—", FORMAT ( _n, "0.00", "pt-BR" ) ) & "<small>/ 5</small>"
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:32px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Nota Média de Atendimento</span>"
			        & "<div class='ico pulse'><svg viewBox='0 0 24 24'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/></svg></div></div>"
			        & "<div class='val' style='color:" & IF ( _n >= 4, "#00A88C", "#2C3E50" ) & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & "<span class='stars'>★★★★★<span style='width:" & FORMAT ( DIVIDE ( _n, 5 ) * 100, "0.0", "en-US" ) & "%'>★★★★★</span></span>"
			            & "<span>" & FORMAT ( _q, "#,0", "pt-BR" ) & " avaliações</span>" & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Qualidade percebida</div><div class='mg'>" & "<div><span>Espera ≤ 30 min</span><b>" & ( IF ( ISBLANK ( [Nota Espera Dentro SLA] ), "—", FORMAT ( [Nota Espera Dentro SLA], "0.00", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Espera > 30 min</span><b>" & ( IF ( ISBLANK ( [Nota Espera Fora SLA] ), "—", FORMAT ( [Nota Espera Fora SLA], "0.00", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Notas 5 ★</span><b>" & ( IF ( ISBLANK ( [% Notas 5] ), "—", FORMAT ( [% Notas 5], "0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>Notas ≤ 3 ★</span><b>" & ( IF ( ISBLANK ( [% Notas Até 3] ), "—", FORMAT ( [% Notas Até 3], "0%", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Melhor avaliado: <b>" & [Top Médico Nota] & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: c874e756-5d61-4b6b-b2f0-3b7e805a92e0

	/// Cartão HTML animado: Tempo de Espera Médio. Use no visual HTML Content.
	measure 'HTML Card Espera' =
			VAR _t = [Tempo Espera Médio]
			VAR _meta = [Meta Tempo Espera]
			VAR _acima = _t > _meta
			VAR _sla = [% Dentro SLA Espera]
			VAR _acc = IF ( _acima, "#E8505B", "#00CBA9" )
			VAR _rgb = IF ( _acima, "232,80,91", "0,203,169" )
			VAR _valor = IF ( ISBLANK ( _t ), "—", FORMAT ( _t, "0.0", "pt-BR" ) ) & "<small>min</small>"
			VAR _css = "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{background:transparent;overflow:hidden}.card{font-family:Inter,'Segoe UI',Arial,sans-serif;height:calc(100vh - 18px);margin:6px 8px 12px 8px;background:rgba(255,255,255,0.88);backdrop-filter:blur(10px);border:1px solid rgba(226,232,240,0.95);border-radius:16px;padding:14px 18px 12px 22px;box-shadow:0 2px 10px rgba(44,62,80,0.06);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease,border-color .35s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;cursor:default}.card:hover{transform:translateY(-4px);box-shadow:0 14px 28px rgba(44,62,80,0.14);border-color:rgba(" & _rgb & ",0.55)}.card:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:after{content:'';position:absolute;right:-46px;top:-46px;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(" & _rgb & ",0.13),rgba(" & _rgb & ",0) 70%);transition:transform .6s ease}.card:hover:after{transform:scale(1.5)}.top{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}.lbl{font-size:11px;font-weight:600;color:#64748B;letter-spacing:.6px;text-transform:uppercase}.ico{width:34px;height:34px;border-radius:10px;background:rgba(" & _rgb & ",0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}.ico svg{width:19px;height:19px;stroke:" & _acc & ";fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.pulse{animation:pulse 2.6s ease-in-out infinite}.spin svg{animation:spin 7s linear infinite}.beat svg polyline{stroke-dasharray:64;stroke-dashoffset:64;animation:draw 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(" & _rgb & ",0.35);transform:scale(1)}50%{box-shadow:0 0 0 7px rgba(" & _rgb & ",0);transform:scale(1.07)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes draw{0%{stroke-dashoffset:64}50%{stroke-dashoffset:0}100%{stroke-dashoffset:-64}}@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes grow{from{width:0}}.val{font-size:32px;font-weight:700;letter-spacing:-.5px;line-height:1.1;position:relative;z-index:1;animation:up .9s cubic-bezier(.2,.8,.2,1) both}.val small{font-size:11px;font-weight:500;color:#64748B;letter-spacing:0;margin-left:6px}.foot{font-size:11px;color:#64748B;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;position:relative;z-index:1}.pill{font-weight:700;padding:2px 8px;border-radius:20px;font-size:10.5px}.bar{flex:1;min-width:60px;height:6px;border-radius:6px;background:#EEF2F6;position:relative;display:flex;overflow:visible}.bar i{display:block;height:100%;border-radius:6px;animation:grow 1.4s cubic-bezier(.2,.8,.2,1) both}.bar b{position:absolute;top:-3px;width:2px;height:12px;border-radius:2px;background:#2C3E50}.stars{position:relative;display:inline-block;color:#E2E8F0;font-size:13px;letter-spacing:2px}.stars span{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#F5B700;animation:grow 1.6s ease-out both}.more{position:absolute;inset:0;z-index:5;border-radius:16px;padding:11px 16px 9px 22px;color:#fff;background:linear-gradient(150deg,rgba(44,62,80,0.97) 0%,rgba(31,45,58,0.97) 60%,rgba(27,59,61,0.97) 100%);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}.more:before{content:'';position:absolute;left:0;top:16px;bottom:16px;width:4px;border-radius:0 4px 4px 0;background:" & _acc & "}.card:hover .more{opacity:1;transform:none}.mt{font-size:9.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;color:#33D6BB;display:flex;justify-content:space-between}.mt em{font-style:normal;color:#94A3B8;font-weight:500;letter-spacing:.3px;text-transform:none}.mg{display:grid;grid-template-columns:1fr 1fr;gap:3px 14px}.mg div{display:flex;justify-content:space-between;align-items:baseline;gap:6px;border-bottom:1px dashed rgba(255,255,255,0.10);padding-bottom:2px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}.card:hover .mg div{opacity:1;transform:none}.card:hover .mg div:nth-child(2){transition-delay:.06s}.card:hover .mg div:nth-child(3){transition-delay:.12s}.card:hover .mg div:nth-child(4){transition-delay:.18s}.mg span{font-size:9.5px;color:#94A3B8;white-space:nowrap}.mg b{font-size:12px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mi{font-size:10px;color:#E2E8F0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .5s .25s ease}.mi b{color:#33D6BB}.card:hover .mi{opacity:1}.hint{position:absolute;right:10px;bottom:6px;font-size:8.5px;color:#CBD5E1;letter-spacing:.3px;z-index:2;transition:opacity .3s}.card:hover .hint{opacity:0}</style>"
			RETURN
			    _css
			        & "<div class='card'><div class='top'><span class='lbl'>Tempo de Espera Médio</span>"
			        & "<div class='ico spin'><svg viewBox='0 0 24 24'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg></div></div>"
			        & "<div class='val' style='color:" & IF ( _acima, "#D64550", "#00A88C" ) & "'>" & _valor & "</div>"
			        & "<div class='foot'>" & "<span class='pill' style='background:" & IF ( _acima, "rgba(232,80,91,0.12);color:#D64550'>acima da meta", "rgba(0,203,169,0.14);color:#00A88C'>dentro da meta" ) & "</span>"
			            & "<span>" & FORMAT ( _sla, "0%", "pt-BR" ) & " em até " & _meta & " min</span>" & "</div>"
			        & "<div class='hint'>ⓘ detalhes</div>"
			        & "<div class='more'><div class='mt'>Distribuição da espera</div><div class='mg'>" & "<div><span>Mediana</span><b>" & ( IF ( ISBLANK ( [Tempo Espera Mediana] ), "—", FORMAT ( [Tempo Espera Mediana], "0", "pt-BR" ) ) & " min" ) & "</b></div>" & "<div><span>Máximo</span><b>" & ( IF ( ISBLANK ( [Tempo Espera Máximo] ), "—", FORMAT ( [Tempo Espera Máximo], "0", "pt-BR" ) ) & " min" ) & "</b></div>" & "<div><span>> 45 min</span><b>" & ( IF ( ISBLANK ( [% Espera Acima 45] ), "—", FORMAT ( [% Espera Acima 45], "0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>No SLA</span><b>" & ( IF ( ISBLANK ( [% Dentro SLA Espera] ), "—", FORMAT ( [% Dentro SLA Espera], "0%", "pt-BR" ) ) ) & "</b></div>" & "</div>"
			        & "<div class='mi'>" & ( "Unidade mais lenta: <b>" & [Top Unidade Espera] & " (" & FORMAT ( CALCULATE ( [Tempo Espera Médio], TREATAS ( { [Top Unidade Espera] }, Dim_Clinicas[Unidade] ) ), "0.0", "pt-BR" ) & " min" & ")" & "</b>" ) & "</div></div>"
			        & "</div>"
		displayFolder: 06 HTML Cards
		lineageTag: a49c8f4a-3100-4e3d-9d1b-5b9bfc10386d

	/// Cartão HTML animado: Consultas Realizadas. Use no visual HTML Content.
	measure 'HTML Card Realizadas' =
			VAR _r = [% Realização]
			VAR _ag = [Agendamentos]
			VAR _acc = "#2C3E50"
			VAR _rgb = "44,62,80"
			VAR _valor = IF ( ISBLANK ( [Consultas Realizadas] ), "—", FORMAT ( [Consultas Realizadas], "#,0", "pt-BR" ) )
