	partition Dim_Especialidades = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(PastaDados & "VittaCare_Database.xlsx"), null, true),
				    Aba = Fonte{[Item="Dim_Especialidades",Kind="Sheet"]}[Data],
				    Cabecalhos = Table.PromoteHeaders(Aba, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"ID_Especialidade", Int64.Type}, {"Nome_Especialidade", type text}, {"Valor_Base_Consulta", type number}}),
				    Renomear = Table.RenameColumns(Tipos, {{"Nome_Especialidade", "Especialidade"}, {"Valor_Base_Consulta", "Valor Base Consulta"}})
				in
				    Renomear

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

