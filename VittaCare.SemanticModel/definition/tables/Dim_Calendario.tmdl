table Dim_Calendario
	lineageTag: 5a24ab5c-e6fe-4708-afbf-66f5f0e3bb77
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: cc317bad-e6ce-46c0-b4c7-5e4594638ac2
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 4d10234b-0934-4539-9d1b-dcb2285c3c41
		summarizeBy: none
		sourceColumn: Ano

		annotation SummarizationSetBy = User

	column 'Mês Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6ba3fcf2-a3a7-4ad9-879a-4219b7433dbc
		summarizeBy: none
		sourceColumn: Mês Num

		annotation SummarizationSetBy = User

	column Mês
		dataType: string
		lineageTag: 65d7ad30-4283-4011-966a-ea3f9b22e370
		summarizeBy: none
		sourceColumn: Mês
		sortByColumn: 'Mês Num'

		annotation SummarizationSetBy = User

	column 'Mês Ano'
		dataType: string
		lineageTag: 9c72b1a3-61a6-453d-84a5-bcd95f2d43b5
		summarizeBy: none
		sourceColumn: Mês Ano
		sortByColumn: AnoMes

		annotation SummarizationSetBy = User

	column AnoMes
		dataType: int64
		formatString: 0
		lineageTag: bd46ae53-20a3-42cf-aaa2-748b81f23dce
		summarizeBy: none
		sourceColumn: AnoMes

		annotation SummarizationSetBy = User

	column Trimestre
		dataType: string
		lineageTag: 355b1860-45e9-430e-b7bc-8eb775819fa0
		summarizeBy: none
		sourceColumn: Trimestre

		annotation SummarizationSetBy = User

	column 'Dia da Semana'
		dataType: string
		lineageTag: 2c312717-aa85-457b-ad42-7e13c8fd3469
		summarizeBy: none
		sourceColumn: Dia da Semana
		sortByColumn: 'Dia Semana Num'

		annotation SummarizationSetBy = User

	column 'Dia Semana Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 297efb79-64bc-4af1-8679-58cc5b4c5110
		summarizeBy: none
		sourceColumn: Dia Semana Num

		annotation SummarizationSetBy = User

	partition Dim_Calendario = m
		mode: import
		source =
				let
				    Inicio = #date(2024, 1, 1),
				    Fim = #date(2025, 12, 31),
				    Lista = List.Dates(Inicio, Duration.Days(Fim - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Tabela = Table.FromList(Lista, Splitter.SplitByNothing(), {"Data"}),
				    Tipo = Table.TransformColumnTypes(Tabela, {{"Data", type date}}),
				    Ano = Table.AddColumn(Tipo, "Ano", each Date.Year([Data]), Int64.Type),
				    MesNum = Table.AddColumn(Ano, "Mês Num", each Date.Month([Data]), Int64.Type),
				    Mes = Table.AddColumn(MesNum, "Mês", each Text.Proper(Text.Start(Date.MonthName([Data], "pt-BR"), 3)), type text),
				    MesAno = Table.AddColumn(Mes, "Mês Ano", each [Mês] & "/" & Text.End(Text.From([Ano]), 2), type text),
				    AnoMes = Table.AddColumn(MesAno, "AnoMes", each [Ano] * 100 + [Mês Num], Int64.Type),
				    Trimestre = Table.AddColumn(AnoMes, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([Data])), type text),
				    DiaSemana = Table.AddColumn(Trimestre, "Dia da Semana", each Text.Proper(Date.DayOfWeekName([Data], "pt-BR")), type text),
				    DiaSemanaNum = Table.AddColumn(DiaSemana, "Dia Semana Num", each Date.DayOfWeek([Data], Day.Monday) + 1, Int64.Type)
				in
				    DiaSemanaNum

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

